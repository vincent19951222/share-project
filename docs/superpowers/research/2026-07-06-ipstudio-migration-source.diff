+export const retryGenerationTask = async (
+  taskId: string
+): Promise<GenerationTaskCreateResponse> => {
+  const response = await fetch(`/api/images/tasks/${encodeURIComponent(taskId)}/retry`, {
+    method: 'POST',
+  });
+  const payload = await readJson(response);
+
+  if (!response.ok) {
+    throw new Error(payload?.error || `Generation task retry failed (${response.status}).`);
+  }
+
+  if (typeof payload?.taskId !== 'string') {
+    throw new Error('Generation task retry failed: response did not include taskId.');
+  }
+
+  return { taskId: payload.taskId };
+};
+
