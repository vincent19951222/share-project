+export const retryGenerationTaskResponse = (taskId: string) => {
+  try {
+    const repository = createPlaygroundTaskRepository();
+    let retryTaskId = '';
+    let images: string[] = [];
+
+    try {
+      const detail = repository.getTaskWithItems(taskId);
+
+      if (!detail) {
+        return NextResponse.json({ error: 'Task not found.' }, { status: 404 });
+      }
+
+      if (detail.task.status !== 'failed' && detail.task.status !== 'partial') {
+        return NextResponse.json({ error: RETRY_STATUS_ERROR }, { status: 400 });
+      }
+
+      images = repository.getTaskInputImages(taskId);
+      if (images.length === 0) {
+        return NextResponse.json({ error: RETRY_INPUT_ERROR }, { status: 400 });
+      }
+
+      if (detail.task.mode === 'lab') {
+        getPublishedDesignScenePrompt(detail.task.sceneId, { userPrompt: detail.task.userPrompt });
+      } else {
+        getPublishedDesignScenePrompt(detail.task.sceneId);
+      }
+
+      retryTaskId = createId('task');
+      repository.createTask({
+        id: retryTaskId,
+        mode: detail.task.mode,
+        sceneId: detail.task.sceneId,
+        userPrompt: detail.task.userPrompt,
+        count: detail.task.count,
+        inputImages: images,
+        items: Array.from({ length: detail.task.count }, (_, index) => ({
+          id: createId('item'),
+          index,
+          generationId: createId('gen'),
+        })),
+      });
+    } finally {
+      repository.close();
+    }
+
+    startPlaygroundTask({ taskId: retryTaskId, images });
+
+    return NextResponse.json({ taskId: retryTaskId });
+  } catch (error) {
+    const message = error instanceof Error ? error.message : 'Task retry failed.';
+    return NextResponse.json({ error: message }, { status: getErrorStatus(message) });
+  }
+};
